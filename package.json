    "url": "git+https://github.com/hberkaykuran/revenuecalc.git"
  },
  "bugs": {
    "url": "https://github.com/hberkaykuran/revenuecalc/issues"
  },
  "homepage": "https://github.com/hberkaykuran/revenuecalc#readme",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
