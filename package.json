{
  "name": "revenuecalc",
  "version": "1.0.0",
  "description": "Revenue and campaign calculator",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "build:artifact": "tsc && vite build --mode artifact && node scripts/assemble-artifact.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hberkaykuran/revenuecalc.git"
  },
  "bugs": {
    "url": "https://github.com/hberkaykuran/revenuecalc/issues"
  },
  "homepage": "https://github.com/hberkaykuran/revenuecalc#readme",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}
